# Copy this file to .env and fill in your own keys.
# .env is gitignored and must NEVER be committed — it contains your secret API keys.

# Google AI Studio (for transcribe.py's handwriting OCR)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Groq console (for optional grounded AI answers)
# https://console.groq.com/keys
GROQ_API_KEY=your_key_here
# Optional override (groq model id) — e.g. qwen/qwen3.8-27b or openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b
